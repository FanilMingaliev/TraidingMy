# Ключ Anthropic для ИИ-анализа. Без него сайт работает, но выдаёт только технические сигналы.
ANTHROPIC_API_KEY=sk-ant-...

# Модель ИИ (по умолчанию claude-opus-5)
AI_MODEL=claude-opus-5

# Порт бэкенда
PORT=8787

# Журнал сигналов в облаке Supabase (необязательно).
# Без этих переменных журнал пишется в локальные файлы data/journal.
# SERVICE_KEY — секретный ключ service_role из панели Supabase
# (Project Settings → API → service_role). Держите его только на сервере.
SUPABASE_URL=https://ycgiwcibcqrpgdfbmimw.supabase.co
SUPABASE_SERVICE_KEY=

# Токен доступа: если задан, сервер отвечает извне только с этим токеном в заголовке.
# Обязателен при публикации через туннель. Впишите этот же токен в приложении.
API_TOKEN=
